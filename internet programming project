<!DOCTYPE html>
<html>
<head>
    <title>CampusFind</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>


    <nav>
        <h2>🔎 CampusFind</h2>

        <div>
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#report">Report Item</a>
            <a href="#items">Browse Items</a>
        </div>
    </nav>


    <section class="hero" id="home">

        <div class="hero-text">

            <h4>WELCOME TO CAMPUSFIND</h4>

            <h1>Lost Something?<br>
                <span>Let's Find It.</span>
            </h1>

            <p>
                Lost your belongings on campus?
                Don't worry! CampusFind helps students
                report and find their missing items easily.
            </p>

            <a href="#report" class="btn">Report an Item</a>

            <a href="#items" class="btn second">Explore Items</a>

        </div>

        <div class="hero-image">
            🎒
        </div>

    </section>



    <section class="dashboard" id="dashboard">

        <h2>Our Dashboard</h2>

        <p>Overview of reported items</p>

        <div class="stats">

            <div class="stat">
                <h1 id="total">0</h1>
                <p>Total Reports</p>
            </div>

            <div class="stat">
                <h1 id="lost">0</h1>
                <p>Lost Items</p>
            </div>

            <div class="stat">
                <h1 id="found">0</h1>
                <p>Found Items</p>
            </div>

        </div>

    </section>



    <section class="about" id="about">

        <div>
            <h2>About CampusFind</h2>

            <p>
                CampusFind is a Lost and Found website
                specially designed for college students.
                It helps students report lost belongings
                and search for items found on campus.
            </p>

            <p>
                Our main aim is to save students' time
                and make finding lost items easier.
            </p>
        </div>

        <div class="about-icon">
            🤝
        </div>

    </section>



    <section class="how">

        <h2>How It Works</h2>

        <p>Three easy steps to find your belongings</p>

        <div class="steps">

            <div class="step">
                <h1>📝</h1>
                <h3>Report an Item</h3>
                <p>Add details of your lost or found item.</p>
            </div>

            <div class="step">
                <h1>🔍</h1>
                <h3>Search an Item</h3>
                <p>Search and explore reported items.</p>
            </div>

            <div class="step">
                <h1>🤝</h1>
                <h3>Get It Back</h3>
                <p>Connect with the person who found it.</p>
            </div>

        </div>

    </section>


    <section class="report" id="report">

        <h2>Report Your Item</h2>

        <p>Enter the details of your item below.</p>

        <form id="myForm">

            <label>Item Name</label>

            <input type="text" id="name"
                placeholder="Enter item name" required>


            <label>Category</label>

            <select id="category" required>
                <option value="">Select Category</option>
                <option>Electronics</option>
                <option>Books</option>
                <option>ID Card</option>
                <option>Bags</option>
                <option>Other</option>
            </select>


            <label>Report Type</label>

            <select id="type" required>
                <option value="">Select Type</option>
                <option>Lost</option>
                <option>Found</option>
            </select>


            <label>Location</label>

            <input type="text" id="location"
                placeholder="Enter location" required>


            <button type="button" onclick="addItem()">
                Submit Report
            </button>

        </form>

    </section>



    <section class="items" id="items">

        <h2>Browse Lost & Found Items</h2>

        <p>Search items reported by students.</p>

        <input type="text" id="search"
            placeholder="Search item name..."
            onkeyup="searchItem()">

        <div id="itemList" class="item-list">

            <p>No items reported yet.</p>

        </div>

    </section>


    <section class="contact">

        <h2>Helping Students, Together!</h2>

        <p>
            CampusFind makes your campus life
            easier and more convenient.
        </p>

        <a href="#report" class="btn">Report Now</a>

    </section>

    <footer>

        <h2>🔎 CampusFind</h2>

        <p>Lost Less. Find More.</p>

        <p>© 2026 CampusFind. Student Project.</p>

    </footer>


    <script src="css.js"></script>

</body>
</html>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f7f8fc;
    color: #25243a;
}


nav {
    background: white;
    padding: 22px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav h2 {
    color: #6246ea;
}

nav a {
    text-decoration: none;
    color: #444;
    margin: 10px;
    font-weight: bold;
}

nav a:hover {
    color: #6246ea;
}


.hero {
    margin: 35px 7%;
    padding: 60px;
    background: #eeeaff;
    border-radius: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.hero-text h4 {
    color: #6246ea;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 45px;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #6246ea;
}

.hero p {
    color: #666;
    line-height: 1.7;
    max-width: 450px;
    margin-bottom: 25px;
}

.hero-image {
    font-size: 130px;
    background: white;
    padding: 35px;
    border-radius: 50%;
}

.btn {
    display: inline-block;
    background: #6246ea;
    color: white;
    padding: 13px 20px;
    border-radius: 7px;
    text-decoration: none;
}

.btn:hover {
    background: #4931c4;
}

.second {
    background: white;
    color: #6246ea;
    margin-left: 10px;
}


.dashboard {
    text-align: center;
    padding: 60px 7%;
}

.dashboard h2,
.about h2,
.how h2,
.report h2,
.items h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

.dashboard > p,
.how > p,
.report > p,
.items > p {
    color: #777;
    margin-bottom: 30px;
}

.stats {
    display: flex;
    justify-content: center;
    gap: 25px;
}

.stat {
    background: white;
    padding: 30px;
    width: 30%;
    border-radius: 12px;
    border-bottom: 4px solid #6246ea;
}

.stat h1 {
    color: #6246ea;
    margin-bottom: 10px;
}

.stat p {
    color: #777;
}

.about {
    background: white;
    padding: 70px 10%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
}

.about div:first-child {
    max-width: 600px;
}

.about p {
    color: #777;
    line-height: 1.8;
    margin-top: 15px;
}

.about-icon {
    background: #eeeaff;
    font-size: 90px;
    padding: 35px;
    border-radius: 50%;
}


.how {
    padding: 70px 7%;
    text-align: center;
}

.steps {
    display: flex;
    gap: 20px;
    margin-top: 35px;
}

.step {
    background: white;
    padding: 30px;
    border-radius: 12px;
    width: 33.33%;
}

.step h1 {
    font-size: 45px;
    margin-bottom: 15px;
}

.step h3 {
    margin-bottom: 12px;
}

.step p {
    color: #777;
    line-height: 1.6;
}

.report {
    background: #eeeaff;
    padding: 70px 7%;
    text-align: center;
}

form {
    background: white;
    max-width: 650px;
    margin: auto;
    padding: 30px;
    border-radius: 12px;
    text-align: left;
}

form label {
    display: block;
    margin: 15px 0 8px;
    font-weight: bold;
}

form input,
form select {
    width: 100%;
    padding: 13px;
    border: 1px solid #ddd;
    border-radius: 7px;
    font-size: 15px;
}

form button {
    width: 100%;
    background: #6246ea;
    color: white;
    padding: 14px;
    border: none;
    border-radius: 7px;
    margin-top: 25px;
    cursor: pointer;
    font-size: 16px;
}

form button:hover {
    background: #4931c4;
}


/* Browse Items */

.items {
    padding: 70px 7%;
    text-align: center;
}

#search {
    width: 100%;
    max-width: 500px;
    padding: 14px;
    border: 1px solid #ddd;
    border-radius: 7px;
    margin-bottom: 30px;
}

.item-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.item-card {
    background: white;
    width: 270px;
    padding: 25px;
    text-align: left;
    border-radius: 12px;
    border: 1px solid #eee;
}

.item-card h3 {
    color: #6246ea;
    margin-bottom: 15px;
}

.item-card p {
    color: #666;
    margin: 10px 0;
}

.item-card button {
    background: #6246ea;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 6px;
    margin-top: 15px;
    cursor: pointer;
}



.contact {
    background: #eeeaff;
    text-align: center;
    padding: 60px 20px;
}

.contact h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

.contact p {
    color: #777;
    margin-bottom: 25px;
}


/* Footer */

footer {
    background: #211b3b;
    color: white;
    text-align: center;
    padding: 35px;
    line-height: 2;
}



@media (max-width: 700px) {

    nav {
        flex-direction: column;
        gap: 20px;
    }

    nav div {
        text-align: center;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        gap: 35px;
        padding: 30px;
    }

    .hero h1 {
        font-size: 35px;
    }

    .stats {
        flex-direction: column;
    }

    .stat {
        width: 100%;
    }

    .about {
        flex-direction: column;
        text-align: center;
    }

    .steps {
        flex-direction: column;
    }

    .step {
        width: 100%;
    }

}

let items = [];


function addItem() {

    let name = document.getElementById("name").value;

    let category = document.getElementById("category").value;

    let type = document.getElementById("type").value;

    let location = document.getElementById("location").value;



    if (name == "" || category == "" ||
        type == "" || location == "") {

        alert("Please fill all details");

    }

    else {

    

        let item = {

            name: name,

            category: category,

            type: type,

            location: location

        };


     

        items.push(item);



        document.getElementById("myForm").reset();


        // Display items

        displayItems();


        alert("Item added successfully!");

    }

}


function displayItems() {

    let list = document.getElementById("itemList");

    list.innerHTML = "";


    for (let i = 0; i < items.length; i++) {

        list.innerHTML += `

            <div class="item-card">

                <h3>${items[i].name}</h3>

                <p>Category: ${items[i].category}</p>

                <p>Type: ${items[i].type}</p>

                <p>Location: ${items[i].location}</p>

                <button onclick="deleteItem(${i})">
                    Delete Item
                </button>

            </div>

        `;

    }



    document.getElementById("total").innerText = items.length;


    let lostCount = 0;

    let foundCount = 0;


    for (let i = 0; i < items.length; i++) {

        if (items[i].type == "Lost") {

            lostCount++;

        }

        else if (items[i].type == "Found") {

            foundCount++;

        }

    }


    document.getElementById("lost").innerText = lostCount;

    document.getElementById("found").innerText = foundCount;

}


function searchItem() {

    let value = document.getElementById("search").value.toLowerCase();

    let cards = document.getElementsByClassName("item-card");


    for (let i = 0; i < items.length; i++) {

        let name = items[i].name.toLowerCase();

        if (name.includes(value)) {

            cards[i].style.display = "block";

        }

        else {

            cards[i].style.display = "none";

        }

    }

}




function deleteItem(index) {

    items.splice(index, 1);

    displayItems();

}


