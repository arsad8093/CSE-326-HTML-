<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Court Hub</title>
    <link rel="stylesheet" href="ruf.css">
</head>

<body>

    <div id="a">
        <a href="#top" class="burger">🍔 Food Hub</a>
        <a href="#top" class="burger">Home</a>
        <a href="#food" class="burger">Food</a>
        <a href="#bottom" class="burger">Contacts</a>
    </div>




    <div id="food">

        <h3 class="red">Your Food GUIDE</h3>

        <h1>Hungry? Find Your FOOD.</h1>

        <p class="white">
            Explore food, discover menus and find your favourite meals in one place.
        </p>

        <a href="#burger-section" class="button">Explore Food</a>

    </div>

    <div class="b" id="burger-section">

        <img
            src="https://img.magnific.com/premium-photo/juicy-burger-splash-with-flying-ingredients-dark-background-fast-food-explosion-concept_1428223-575.jpg?semt=ais_hybrid&w=740&q=80"
            alt="Burger picture"
            class="img"
            onclick="showFood('Burger')">

        <div>

            <h2 class="text">Delicious Burger</h2>

            <h3>Explore the best burgers on campus. Hot, crispy, and fresh just for you!</h3>

            <p>Made with fresh veggies and premium cheese slice.</p>

            <p>Starting with just ₹199/-</p>

            <button onclick="showFood('Burger')">Order Now</button>

        </div>

    </div>

    <div class="third">

        <img
            src="https://img.magnific.com/premium-photo/pizza-with-slice-missing-is-falling-into-water_1123417-2427.jpg?semt=ais_hybrid&w=740&q=80"
            alt="Pizza"
            class="img2"
            onclick="showFood('Pizza')">

        <div>

            <h2 class="text2">Delicious Pizza</h2>

            <h3>Explore the best variety of Pizza.</h3>

            <p>Choose from classic Margherita, Farmhouse Veggie, or spicy Paneer toppings.</p>

            <p>Starting with just ₹299/- only</p>

            <button onclick="showFood('Pizza')">Order Now</button>

        </div>

    </div>

    <div class="four">

        <img
            src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR00PuHeJ4CQn63oNg1kHoqo0AO5PLee7cwlvpdbZDJuw&s=10"
            alt="Sweets"
            class="img3"
            onclick="showFood('Sweets')">

        <div>

            <h2 class="text3">Sweets with Great Ingredients</h2>

            <h3>Available in so many varieties.</h3>

            <p>Made with authentic ghee, dry fruits, and pure milk.</p>

            <p>Starting with just ₹99/- only</p>

            <button onclick="showFood('Sweets')">Order Now</button>

        </div>

    </div>

    <div id="div2">

        <h1>What's on Your Plate?</h1>

        <h4 class="text5">
            Compare popular dishes, check their prices and choose your next meal.
        </h4>

    </div>


    <table id="table">

        <thead class="text4">

            <tr>
                <th>Dish Name</th>
                <th>Price (INR)</th>
                <th>Specialty</th>
            </tr>

        </thead>

        <tbody>

            <tr>
                <td>🍔 Delicious Burger</td>
                <td>₹199</td>
                <td>Crispy & Fresh</td>
            </tr>

            <tr>
                <td>🍕 Cheesy Pizza</td>
                <td>₹299</td>
                <td>Loaded with Veggies</td>
            </tr>

            <tr>
                <td>Sweets & Desserts</td>
                <td>₹99</td>
                <td>Pure Ingredients</td>
            </tr>

            <tr>
                <td>🍟 French Fries</td>
                <td>₹120</td>
                <td>Salted & Golden</td>
            </tr>

            <tr>
                <td>🧋 Choco Milkshake</td>
                <td>₹150</td>
                <td>Thick & Creamy</td>
            </tr>

            <tr>
                <td>🍰 Red Velvet Cake</td>
                <td>₹180</td>
                <td>Rich & Fluffy</td>
            </tr>

        </tbody>

    </table>

    <div class="meal" id="booking">

        <h2>Book Your Table!!</h2>

        <form onsubmit="return bookTable()">

            <table>

                <tr>
                    <td><label for="name">Enter Name</label></td>
                    <td><input type="text" id="name" placeholder="Your name"></td>
                </tr>

                <tr>
                    <td><label for="age">Enter Age</label></td>
                    <td><input type="number" id="age" placeholder="Your age"></td>
                </tr>

                <tr>
                    <td><label for="number">Contact Number</label></td>
                    <td><input type="tel" id="number" placeholder="Your phone number"></td>
                </tr>

                <tr>
                    <td><label for="date">Date of Arrival</label></td>
                    <td><input type="date" id="date"></td>
                </tr>

                <tr>
                    <td><label for="persons">Number of Persons</label></td>

                    <td>
                        <select id="persons">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                        </select>
                    </td>
                </tr>

                <tr>
                    <td colspan="2">
                        <button type="submit">Submit Booking</button>
                    </td>
                </tr>

            </table>

            <p id="message"></p>

        </form>

    </div>


    <div id="bottom">

        <h1 class="bottom">That's a Wrap! 🍽️</h1>

        <h2>Good Food. Great Mood.</h2>

        <p>
            From quick bites to delicious treats, your next favourite meal is just around the corner.
        </p>

        <p>Thanks for exploring Food Court Hub!</p>

        <h3>Eat Well. Stay Happy. ❤️</h3>

        <p>© 2026 Food Court Hub | Made for Food Lovers</p>

    </div>


    <script src="scriptt.js"></script>

</body>

</html>


